{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/product",
      "destination": "/produtos",
      "permanent": true
    },
    {
      "source": "/product/gel",
      "destination": "/produtos/gel-de-limpeza-facial",
      "permanent": true
    },
    {
      "source": "/product/serum",
      "destination": "/produtos/serum-facial-clareador",
      "permanent": true
    },
    {
      "source": "/product/fps50",
      "destination": "/produtos/creme-facial-fps75",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/ativos",
      "permanent": true
    },
    {
      "source": "/smart-choice",
      "destination": "/escolha-inteligente",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/manifesto",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/politica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/politica-de-cookies",
      "permanent": true
    },
    {
      "source": "/terms-of-use",
      "destination": "/termos-de-uso",
      "permanent": true
    },
    {
      "source": "/blog/1",
      "destination": "/blog/a-arte-como-forma-de-expressao-na-criacao-de-uma-marca",
      "permanent": true
    },
    {
      "source": "/blog/2",
      "destination": "/blog/a-estetica-contemporanea-e-as-possibilidades",
      "permanent": true
    },
    {
      "source": "/blog/3",
      "destination": "/blog/o-cuidado-com-a-pele-evoluiu-e-a-sua-rotina",
      "permanent": true
    },
    {
      "source": "/blog/inovacao-e-sustentabilidade-o-futuro-dos-cosmeticos",
      "destination": "/blog/o-cuidado-com-a-pele-evoluiu-e-a-sua-rotina",
      "permanent": true
    },
    {
      "source": "/blog/4",
      "destination": "/blog/vida-to-the-fullest-e-o-que-isso-significa",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/200.html"
    }
  ]
}
